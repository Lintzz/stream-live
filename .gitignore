# Diretórios de compilação
bin/
obj/
publish_zip/
.dotnet/
TestResults/

# Temporários do build WPF: o MSBuild cria projetos "_wpftmp" ao lado do .csproj e
# nem sempre apaga quando a compilação é interrompida.
*_wpftmp.csproj

# Arquivos locais e de cache
*.user
*.suo
*.log
*.binlog
.vs/
.vscode/
.idea/

# Configuração local do Claude Code, exceto as skills do projeto (essas são versionadas).
.claude/*
!.claude/skills/

# Lixo do Explorer do Windows
Thumbs.db
desktop.ini

# Instalador gerado e seu arquivo de verificação, na raiz (OutputDir do setup.iss)
/StreamLive_Setup.exe
/StreamLive_Setup.exe.sha256

# Gerado pelo build a partir de <Version> no .csproj
/build/version.iss

# lz-kit (início) — gerado pelo instalador. Edite FORA deste bloco: o que estiver aqui dentro é sobrescrito na atualização.

