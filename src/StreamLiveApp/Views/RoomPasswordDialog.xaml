<Window x:Class="StreamLiveApp.RoomPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha da sala" SizeToContent="Height" Width="400"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181E" CornerRadius="8" BorderBrush="#2D2D35" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <TextBlock x:Name="TxtTitle" Text="Senha da sala" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtSubtitle" Foreground="#AAAAAA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Deixe em branco para que qualquer amigo possa entrar."/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TxtPassword" Grid.Column="0" Height="32" Background="#1E1E24" Foreground="White"
                             BorderBrush="#3D3D45" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                             CaretBrush="White" PasswordChanged="Password_Changed"/>
                <TextBox x:Name="TxtPasswordVisible" Grid.Column="0" Height="32" Background="#1E1E24" Foreground="White"
                         BorderBrush="#3D3D45" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                         CaretBrush="White" Visibility="Collapsed" TextChanged="Password_Changed"/>
                <ToggleButton x:Name="BtnReveal" Grid.Column="1" Width="34" Height="32" Margin="6,0,0,0"
                              Background="#2D2D35" Foreground="#AAAAAA" BorderThickness="0" Cursor="Hand"
                              Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                              Checked="BtnReveal_Changed" Unchecked="BtnReveal_Changed" ToolTip="Mostrar senha">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <TextBlock x:Name="TxtError" Foreground="#FF6B6B" FontSize="12" Margin="0,8,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- Só o host vê este bloco; para o viewer ele fica colapsado. -->
            <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed" Margin="0,18,0,0">
                <Border Background="#1E1E24" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkPrivateLive" Foreground="White" FontSize="13"
                                  Content="Live privada" Checked="ChkPrivateLive_Changed" Unchecked="ChkPrivateLive_Changed"/>
                        <TextBlock Foreground="#8A8A94" FontSize="11" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="Só os amigos marcados abaixo veem que você está transmitindo."/>

                        <ScrollViewer x:Name="InvitedScroll" MaxHeight="180" Margin="26,10,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="False">
                            <ItemsControl x:Name="LstInvited">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsInvited, Mode=TwoWay}" Margin="0,0,0,6" Foreground="#EEEEEE" FontSize="13">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="#EEEEEE" FontSize="13"/>
                                                <TextBlock Text="{Binding Ip}" Foreground="#8A8A94" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="TxtNoFriends" Foreground="#8A8A94" FontSize="11" Margin="26,10,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Você ainda não tem amigos salvos para convidar."/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtPrivacyWarning" Foreground="#E8A33D" FontSize="11" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Nenhum amigo marcado — ninguém vai conseguir ver esta live."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,10,0"
                        Style="{StaticResource DialogButton}" Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm" Content="Iniciar" Width="100" Height="32" Background="#0094F2" Foreground="White"
                        Style="{StaticResource DialogButton}" Click="BtnConfirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
