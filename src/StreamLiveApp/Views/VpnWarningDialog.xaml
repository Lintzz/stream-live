<Window x:Class="StreamLiveApp.VpnWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radmin VPN" SizeToContent="Height" Width="420"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181E" CornerRadius="8" BorderBrush="#2D2D35" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <TextBlock Text="Radmin VPN não está aberto" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="O Stream Live usa a Radmin VPN para falar com seus amigos. Com ela fechada todo mundo aparece offline e ninguém consegue entrar nas suas lives."/>

            <TextBlock x:Name="TxtNotInstalled" Foreground="#E8A33D" FontSize="12" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Não encontramos a Radmin VPN instalada nesta máquina. Instale-a e abra antes de transmitir."/>

            <TextBlock x:Name="TxtError" Foreground="#FF6B6B" FontSize="12" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnIgnore" Content="Continuar assim mesmo" Width="160" Height="32" Margin="0,0,10,0"
                        Style="{StaticResource DialogButton}" Click="BtnIgnore_Click"/>
                <Button x:Name="BtnOpen" Content="Abrir Radmin VPN" Width="140" Height="32" Background="#0094F2" Foreground="White"
                        Style="{StaticResource DialogButton}" Click="BtnOpen_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
