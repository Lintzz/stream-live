<Window x:Class="StreamLiveApp.BroadcastDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamLiveApp"
        Title="Transmitir" SizeToContent="Height" Width="600"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <!-- No ContentPresenter: o Foreground local do "Transmitir" (branco)
                                     ganharia de um Setter no próprio botão. -->
                                <Setter TargetName="content" Property="TextElement.Foreground" Value="#8A8A94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cada tela é um item da lista: a lista dá seleção, setas e o padrão de seleção do
             leitor de tela de graça. O visual é o card com a miniatura, sem nada do ListBox. -->
        <Style x:Key="ScreenItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="#1E1E24" BorderBrush="#2D2D35" BorderThickness="2"
                                CornerRadius="8" Padding="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#6A6A75"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#0094F2"/>
                                <Setter TargetName="card" Property="Background" Value="#1A2633"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181E" CornerRadius="8" BorderBrush="#2D2D35" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <TextBlock x:Name="TxtTitle" Text="Transmitir" Foreground="White" FontSize="16" FontWeight="SemiBold"/>

            <TextBlock x:Name="LblScreens" Text="Escolha a tela" Foreground="#9A9AA4" FontSize="12"
                       FontWeight="SemiBold" Margin="0,16,0,8"/>
            <ListBox x:Name="LstScreens" Background="Transparent" BorderThickness="0" Padding="0"
                     AutomationProperties.LabeledBy="{Binding ElementName=LblScreens}"
                     ItemContainerStyle="{StaticResource ScreenItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="360"
                     KeyboardNavigation.TabNavigation="Once"
                     SelectionChanged="LstScreens_SelectionChanged" MouseDoubleClick="LstScreens_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Height="140" Background="#101014">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Sem miniatura (ainda carregando, ou a captura falhou): fica o
                                     nome da tela no lugar, e dá para escolher do mesmo jeito. -->
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#6A6A75"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="2,8,2,2">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#9A9AA4" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtNoScreens" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       local:LiveAnnouncer.Mode="Assertive"
                       Text="Nenhuma tela encontrada para transmitir. Confira se o monitor está ligado e tente de novo."/>

            <!-- Só ao iniciar a live; em "Trocar tela" fica colapsado. -->
            <StackPanel x:Name="StartOptionsPanel">
                <TextBlock x:Name="LblAudience" Text="Quem pode ver" Foreground="#9A9AA4" FontSize="12"
                           FontWeight="SemiBold" Margin="0,8,0,8"/>
                <Border Background="#1E1E24" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <ScrollViewer x:Name="InvitedScroll" MaxHeight="150" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LstInvited" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsInvited, Mode=TwoWay}" Margin="0,3,10,3"
                                                  AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Hint}">
                                            <TextBlock Text="{Binding Name}" Foreground="#EEEEEE" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="TxtNoFriends" Foreground="#9A9AA4" FontSize="12" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="Você ainda não tem amigos salvos. Adicione em &quot;Gerenciar amigos&quot; para que vejam suas lives."/>

                        <!-- Grade, e não StackPanel horizontal: o StackPanel dá largura infinita
                             ao texto, que não quebra e é cortado na borda. -->
                        <Grid x:Name="AudiencePanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AudienceIcon" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#9A9AA4" VerticalAlignment="Top" Margin="0,2,6,0"/>
                            <TextBlock x:Name="TxtAudience" Grid.Column="1" local:LiveAnnouncer.Mode="Polite" Foreground="#9A9AA4" FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Pública — todos os seus amigos veem. Marque alguém para transmitir só para essas pessoas."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LblPassword" Text="Senha da sala (opcional)" Foreground="#9A9AA4" FontSize="12"
                           FontWeight="SemiBold" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblPassword}"
                                 AutomationProperties.HelpText="{Binding Text, ElementName=TxtPasswordHint}" Height="32" Background="#1E1E24" Foreground="White"
                                 BorderBrush="#6A6A75" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                                 CaretBrush="White" PasswordChanged="Password_Changed"/>
                    <TextBox x:Name="TxtPasswordVisible" Grid.Column="0"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblPassword}" Height="32" Background="#1E1E24" Foreground="White"
                             BorderBrush="#6A6A75" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                             CaretBrush="White" Visibility="Collapsed" TextChanged="Password_Changed"/>
                    <ToggleButton FocusVisualStyle="{StaticResource AppFocusVisual}" AutomationProperties.Name="Mostrar senha" x:Name="BtnReveal" Grid.Column="1" Width="34" Height="32" Margin="6,0,0,0"
                                  Background="#2D2D35" Foreground="#AAAAAA" BorderThickness="0" Cursor="Hand"
                                  Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                  Checked="BtnReveal_Changed" Unchecked="BtnReveal_Changed" ToolTip="Mostrar senha">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
                <TextBlock x:Name="TxtPasswordHint" Foreground="#9A9AA4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Em branco, quem pode ver também entra sem senha."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,10,0"
                        Style="{StaticResource DialogButton}" Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm" Content="Transmitir" Width="110" Height="32" Background="#0078D4" Foreground="White"
                        Style="{StaticResource DialogButton}" Click="BtnConfirm_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
