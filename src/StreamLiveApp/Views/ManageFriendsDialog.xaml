<Window x:Class="StreamLiveApp.ManageFriendsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamLiveApp"
        Title="Gerenciar Amigos" Height="460" Width="520"
        MinHeight="360" MinWidth="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6A6A75"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
            <!-- Erro de validação (IP da lista): borda vermelha e a dica no tooltip, no lugar
                 do adorner padrão, que some atrás da janela sem moldura. -->
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#E81123"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181E" CornerRadius="8" BorderBrush="#2D2D35" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Gerenciar Amigos" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button AutomationProperties.Name="Fechar" Content="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="26" Height="26"
                        HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA"
                        Style="{StaticResource DialogButton}" Click="BtnClose_Click" ToolTip="Fechar"/>
            </Grid>

            <!-- Adicionar novo -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="LblNewName" Text="Apelido" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtNewName" Style="{StaticResource DarkTextBox}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblNewName}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="LblNewIp" Text="IP" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtNewIp" Style="{StaticResource DarkTextBox}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblNewIp}"
                             AutomationProperties.HelpText="IP da Radmin VPN do amigo, ex.: 26.10.0.5"
                             LostFocus="TxtNewIp_LostFocus" TextChanged="TxtNewIp_TextChanged"/>
                </StackPanel>
                <Button Grid.Column="4" Content="Adicionar" Width="80" Height="28" VerticalAlignment="Bottom"
                        Background="#0078D4" Foreground="White" Style="{StaticResource DialogButton}" Click="BtnAdd_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,4,0,8">
                <TextBlock x:Name="TxtAddError" local:LiveAnnouncer.Mode="Assertive" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtHint" Text="Clique nos campos da lista para editar o apelido ou o IP."
                           Foreground="#9A9AA4" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="3" Background="#141419" BorderBrush="#2D2D35" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <TextBlock x:Name="TxtEmpty" Text="Nenhum amigo salvo ainda." Foreground="#9A9AA4" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ListBox x:Name="LstFriends" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="6,4">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="2,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding StatusColor}" ToolTip="Verde: em live | Amarelo: online | Cinza: offline"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Ip, StringFormat='Apelido do amigo {0}'}"
                                             Style="{StaticResource DarkTextBox}" ToolTip="Apelido"/>
                                    <!-- LostFocus, e não a cada tecla: com PropertyChanged o IP
                                         "26.1" virava o IP do amigo (e era sondado e salvo) no meio
                                         da digitação. IP inválido não chega ao amigo. -->
                                    <TextBox Grid.Column="3" Style="{StaticResource DarkTextBox}"
                                             AutomationProperties.Name="{Binding DisplayName, StringFormat='IP de {0}'}">
                                        <TextBox.Text>
                                            <Binding Path="Ip" UpdateSourceTrigger="LostFocus">
                                                <Binding.ValidationRules>
                                                    <local:FriendIpRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <Button AutomationProperties.Name="{Binding DisplayName, StringFormat='Remover {0}'}" Grid.Column="5" Content="&#xE107;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Width="28" Height="28" Background="#3A1F22" Foreground="#E81123"
                                            Style="{StaticResource DialogButton}" Click="BtnRemove_Click" ToolTip="Remover"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <!-- Remover é imediato e oferece desfazer, em vez de pedir confirmação: o IP
                     do amigo só existe na Radmin dele, e um clique errado obrigava a pedir de
                     novo. Modal de confirmação em toda remoção ensinaria a clicar sem ler. -->
                <Border x:Name="UndoBar" Background="#26262E" CornerRadius="5" Padding="10,0,4,0"
                        HorizontalAlignment="Left" Height="30" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUndo" Foreground="#DDDDDD" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnUndo" Content="Desfazer" Margin="8,0,0,0" Padding="10,0" Height="24"
                                Background="Transparent" Foreground="#4FB3FF"
                                Style="{StaticResource DialogButton}" Click="BtnUndo_Click"/>
                    </StackPanel>
                </Border>
                <Button Content="Concluir" Width="90" Height="30" Background="#0078D4" Foreground="White"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DialogButton}" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
