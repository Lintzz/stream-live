<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.3.0</Version>
    <!-- Version é a única fonte da verdade: AssemblyVersion, o texto na UI e o AppVersion
         do Inno Setup saem todos daqui (o build/version.iss é gerado no build). -->
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Product>Stream Live</Product>
    <Description>Transmissão de tela e áudio entre amigos na Radmin VPN, com várias lives em grade.</Description>
    <Authors>Alexandre Lintz</Authors>
    <Company>Lintzz</Company>
    <Copyright>Copyright (c) 2026 Lintzz · Licença MIT</Copyright>
    <RepositoryUrl>https://github.com/Lintzz/stream-live</RepositoryUrl>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- O executável distribuído guardava o caminho desta máquina (D:\Projetos\...) para o .pdb
         e para os fontes. O PathMap troca a raiz do repositório por /_/: o .pdb continua indo
         no instalador (dá número de linha no error.log), sem revelar onde foi compilado. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))=/_/</PathMap>
  </PropertyGroup>

  <!-- Build de diagnóstico só para a máquina do dono: liga o DetailedDiagnostics (log
       segundo a segundo da live). Nunca entra no instalador publicado — o /build não passa
       esta propriedade. Uso: dotnet publish ... -p:DiagDetalhado=true -->
  <PropertyGroup Condition="'$(DiagDetalhado)' == 'true'">
    <DefineConstants>$(DefineConstants);DIAG_DETALHADO</DefineConstants>
  </PropertyGroup>

  <!-- Regras de captura que valem a pena testar sem serem API pública do app. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StreamLiveApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.17" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Websocket.Client" Version="5.5.0" />
  </ItemGroup>

  <!-- Remendo de transitivas: o SIPSorcery 10 traz o IPNetwork2 2.1.2, que puxa o
       NETStandard.Library 1.6.1 e com ele System.Net.Http e System.Text.RegularExpressions
       4.3.0, ambos com advisory Alto (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj). No .NET 8 o
       runtime usa as cópias do próprio framework, mas fixar as versões corrigidas tira o
       pacote vulnerável do grafo. Pode sair quando o SIPSorcery deixar de depender do
       IPNetwork2 2.x (confira com "dotnet list package" e as opções vulnerable e include-transitive). -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <!-- Bibliotecas nativas. O <Link> achata cada uma na raiz da saída: o P/Invoke da
       ApplicationLoopback e o FFmpeg carregam pelo nome, ao lado do executável. -->
  <ItemGroup>
    <None Update="NativeLibs\ApplicationLoopback.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Update="FFmpegLibs\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

  <!-- Mantém o instalador em sincronia com a versão do projeto (build/setup.iss dá #include nele). -->
  <Target Name="GenerateInnoSetupVersion" BeforeTargets="Build;Publish">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/../../build/version.iss"
                      Lines="#define AppVersion &quot;$(Version)&quot;"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
